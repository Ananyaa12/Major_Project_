# .gitignore - Files to exclude from version control

# Environment variables
.env
.env.local
.env.*.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
ENV/
env/
.venv

# ML Models (can be very large)
ml_pipeline/trained_models/*.pkl
ml_pipeline/trained_models/*.joblib
*.h5
*.pth

# Results (optional - can exclude or include)
ml_pipeline/results/
*.csv
*.json
!package.json
!vite.config.js
!postcss.config.js
!vercel.json

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# Frontend Build
frontend/dist/
frontend/.vite/
frontend/coverage/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Sensitive data
secrets.json
credentials.json
*.pem
*.key

# Backups
*.backup
*.bak
